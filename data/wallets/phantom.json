						"$ref": "notSupported"
					},
					"TORNADO_CASH_NOVA": {
						"$ref": "notSupported"
					},
					"PRIVACY_POOLS": {
						"$ref": "notSupported"
					},
					"RAILGUN": {
						"$ref": "notSupported"
					}
				}
			},
			"profile": "WalletProfile.GENERIC",
			"security": {
				"accountRecovery": null,
				"bugBountyProgram": null,
				"duressResistance": null,
