							"url": "https://help.phantom.com/hc/en-us/articles/46595961428627-Can-I-manually-add-networks-to-Phantom"
						},
						"customChainRpcEndpoint": {
							"$call": "notSupportedWithRef",
							"args": [
								{
									"ref": {
										"explanation": "Phantom Support says users cannot manually add new or custom networks; Phantom only supports networks integrated directly into the app.",
										"url": "https://help.phantom.com/hc/en-us/articles/46595961428627-Can-I-manually-add-networks-to-Phantom"
									}
								}
							]
						},
						"l1": {
							"$call": "notSupportedWithRef",
