					}
				}
			},
			"transparency": {
				"operationFees": null,
				"releaseTransparency": {
					"artifactSigning": null,
					"dependencyLocking": null,
					"dependencyVulnerabilityScanning": null,
					"hasPublicChangelog": null,
					"hermeticBuilds": null,
					"repositoryChangeControls": null,
					"reproducibleBuilds": null
				}
			}
		},
		"variants": {
			"MOBILE": true,
			"BROWSER": true
		}
	}
