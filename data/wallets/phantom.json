	"data": {
		"metadata": {
			"id": "phantom",
			"displayName": "Phantom",
			"tableName": "Phantom",
			"blurb": "Phantom is a user-friendly Ethereum and Solana wallet. It focuses on ease of use, easy swapping of tokens and NFTs, and integration with popular DeFi and NFT exchange protocols within the wallet.",
			"contributors": [
				{
					"$ref": "nconsigny"
				},
				{
					"$ref": "mattmatt"
				}
			],
			"iconExtension": "svg",
			"lastUpdated": "2025-02-08",
			"urls": {
				"docs": [
					"https://docs.phantom.com/"
				],
				"extensions": [
					"https://chromewebstore.google.com/detail/phantom/bfnaelmomeimhlpmgjnjophhpkkoljpa"
				],
				"socials": {
					"instagram": "https://www.instagram.com/phantom/",
					"linkedin": "https://www.linkedin.com/company/phantomwallet/",
					"reddit": "https://www.reddit.com/r/Phantom/",
					"x": "https://x.com/phantom",
					"youtube": "https://www.youtube.com/@phantom-wallet"
				},
				"websites": [
					"https://phantom.com"
				]
			}
		},
		"features": {
			"accountSupport": {
				"defaultAccountType": "AccountType.eoa",
				"eip7702": {
					"$ref": "notSupported"
				},
				"eoa": {
					"$call": "supported",
					"args": [
						{
							"ref": [
								{
									"explanation": "Phantom describes a wallet as a top-level container created using a Secret Recovery Phrase or Google/Apple account plus PIN.",
									"url": "https://help.phantom.com/hc/en-us/articles/45465816962579-About-wallets-accounts-and-addresses-in-Phantom"
								},
								{
									"explanation": "Phantom says users can send from a newly created or imported wallet and exposes addresses across supported chains.",
									"url": "https://help.phantom.com/hc/en-us/articles/5530158379539-How-to-send-tokens-to-an-exchange"
								}
							],
							"canExportPrivateKey": true,
							"keyDerivation": {
								"type": "BIP32",
								"canExportSeedPhrase": true,
								"derivationPath": "BIP44",
								"seedPhrase": "BIP39"
							}
						}
					]
				},
				"mpc": {
					"$ref": "notSupported"
				},
				"rawErc4337": {
					"$ref": "notSupported"
				},
				"safe": {
					"$ref": "notSupported"
				}
			},
			"addressResolution": {
				"ref": {
					"explanation": "Phantom's send-token help says users can send to domain names such as solana.sol or vault.eth, which resolve automatically to valid addresses on supported networks.",
					"url": "https://help.phantom.com/hc/en-us/articles/5530158379539-How-to-send-tokens-to-an-exchange"
				},
				"chainSpecificAddressing": {
					"erc7828": null,
					"erc7831": null
				},
				"nonChainSpecificEnsResolution": {
					"$call": "supported",
					"args": [
						{
							"medium": "CHAIN_CLIENT"
						}
					]
				}
			},
			"chainAbstraction": {
				"bridging": {
					"builtInBridging": {
						"$call": "supported",
						"args": [
							{
								"ref": [
									{
										"explanation": "Phantom says its Crosschain Swapper lets users bridge tokens across Solana, Ethereum, Base, and Polygon inside Phantom.",
										"url": "https://phantom.com/learn/blog/cross-chain-swapper"
									},
									{
										"explanation": "Phantom's bridge explainer describes in-wallet bridging through the built-in Crosschain Swapper.",
										"url": "https://phantom.com/learn/crypto-101/crypto-bridge"
									}
								]
							}
						]
					},
					"suggestedBridging": null
				},
				"crossChainBalances": {
					"ref": [
						{
							"explanation": "Phantom describes itself as a multi-chain wallet where users can manage assets across Solana, Ethereum, Polygon, Bitcoin, Base, Sui, and Monad without switching wallets.",
							"url": "https://help.phantom.com/hc/en-us/articles/36481540833939-What-is-Phantom-Wallet-and-What-Is-It-Used-For"
						},
						{
							"explanation": "Phantom says the app supports multiple blockchains in one wallet and lets users store and swap tokens across supported chains.",
							"url": "https://phantom.com/"
						}
					],
					"globalAccountValue": {
						"$ref": "featureSupported"
					},
					"perChainAccountValue": null
