{
  "id": "bitbox",
  "source": "hardware-wallets",
  "export": "bitboxWallet",
  "data": {
    "metadata": {
      "id": "bitbox",
      "displayName": "BitBox",
      "tableName": "BitBox",
      "blurb": "BitBox02 is a hardware wallet with fully open-source firmware and a unique secure chip architecture that doesn't require trusting closed-source code.",
      "contributors": [
        {
          "$ref": "patrickalphac"
        },
        {
          "$ref": "mattmatt"
        }
      ],
      "hardwareWalletManufactureType": "HardwareWalletManufactureType.FACTORY_MADE",
      "hardwareWalletModels": [
        {
          "id": "bitbox02-multi",
          "name": "BitBox02 Multi",
          "isFlagship": true,
          "url": "https://bitbox.swiss/bitbox02/"
        }
      ],
      "iconExtension": "svg",
      "lastUpdated": "2025-01-07",
      "urls": {
        "docs": [
          "https://bitbox.swiss/dev/"
        ],
        "repositories": [
          "https://github.com/BitBoxSwiss/bitbox02-firmware"
        ],
        "socials": {
          "facebook": "https://web.facebook.com/BitBoxSwiss",
          "instagram": "https://www.instagram.com/bitboxswiss/",
          "linkedin": "https://www.linkedin.com/company/bitbox-swiss/",
          "reddit": "https://www.reddit.com/r/BitBoxWallet/",
          "x": "https://x.com/BitBoxSwiss",
          "youtube": "https://www.youtube.com/@bitboxswiss"
        },
        "websites": [
          "https://bitbox.swiss/"
        ]
      }
    },
    "features": {
      "accountSupport": {
        "eoa": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://support.bitbox.swiss/en_US/ethereum-co/ethereum-derivation-path-bitbox02",
                "explanation": "BitBox02 derives Ethereum addresses via BIP-32/44 (coin type 60') and signs their transactions, confirming native EOA account support."
              }
            }
          ]
        },
        "mpc": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://bitbox.swiss/bitbox02/",
                "explanation": "BitBox02 is a traditional dual-chip hardware wallet using a single secure element; no MPC/threshold-signature architecture is described."
              }
            }
          ]
        },
        "rawErc4337": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://bitbox.swiss/bitbox02/",
                "explanation": "BitBox02 provides standard BIP-44 EOA accounts and ERC-20 support; it does not natively create ERC-4337 smart accounts."
              }
            }
          ]
        },
        "safe": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://support.bitbox.swiss/en_US/external-wallet-apps/bitbox02-supported-third-party-wallets-compatibility",
                "explanation": "BitBox02 is a pure hardware signer compatible with third-party wallets; it does not natively create or provide Safe accounts."
              }
            }
          ]
        },
        "eip7702": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://github.com/BitBoxSwiss/bitbox02-firmware/blob/master/CHANGELOG.md",
                "explanation": "The BitBox02 firmware CHANGELOG contains no mention of EIP-7702, transaction type 4, or Pectra support."
              }
            }
          ]
        }
      },
      "appConnectionSupport": {
        "$call": "supported",
        "args": [
          {
            "ref": [
              {
                "explanation": "BitBox blog post explaining WalletConnect integration for secure app connections",
                "url": "https://blog.bitbox.swiss/en/using-walletconnect-to-securely-connect-to-your-favorite-dapp/"
              }
            ],
            "requiresManufacturerConsent": null,
            "supportedConnections": {
              "VENDOR_OPEN_SOURCE_APP": true,
              "RABBY": true
            }
          }
        ]
      },
      "licensing": {
        "type": "LicensingType.SINGLE_WALLET_REPO_AND_LICENSE",
        "walletAppLicense": {
          "ref": [
            {
              "explanation": "BitBox02 firmware is fully open source and verified by WalletScrutiny",
              "url": "https://github.com/BitBoxSwiss/bitbox02-firmware"
            }
          ],
          "license": "FOSSLicense.APACHE_2_0"
        }
      },
      "monetization": {
        "ref": {
          "$ref": "refTodo"
        },
        "revenueBreakdownIsPublic": false,
        "strategies": {
          "donations": null,
          "ecosystemGrants": null,
          "governanceTokenLowFloat": null,
          "governanceTokenMostlyDistributed": null,
          "hiddenConvenienceFees": null,
          "publicOffering": null,
          "selfFunded": null,
          "transparentConvenienceFees": null,
          "ventureCapital": null
        }
      },
      "multiAddress": {
        "$call": "supported",
        "args": [
          {
            "ref": {
              "url": "https://support.bitbox.swiss/en_US/understanding-derivation-paths-bitbox",
              "explanation": "BitBox docs state the derivation path account field starts at 0 and increments for each additional account, confirming multiple Ethereum accounts."
            }
          }
        ]
      },
      "privacy": {
        "analytics": {
          "crashReports": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://support.bitbox.swiss/en_US/privacy/bitboxapp-data-sharing",
                  "explanation": "The BitBoxApp does not embed third-party tracking/analytics/crash tools; logging is anonymized and minimized, with no third-party crash reporting described."
                }
              }
            ]
          },
          "usage": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://support.bitbox.swiss/en_US/privacy/bitboxapp-data-sharing",
                  "explanation": "BitBox support documentation states the BitBoxApp does not embed third-party tracking, advertising, or analytics tools."
                }
              }
            ]
          }
        },
        "dataCollection": {
          "INSTALL": null,
          "UNCLASSIFIED": {
            "collected": [
              {
                "ref": [
                  {
                    "explanation": "BitBoxApp sends IP address for update checks and uses BitBox backend servers for Bitcoin address lookups",
                    "url": "https://bitbox.swiss/policies/privacy-policy/"
                  }
                ],
                "byEntity": {
                  "$ref": "bitbox"
                },
                "dataCollection": {
                  "IP_ADDRESS": "CollectionPolicy.BY_DEFAULT",
                  "ACCOUNT_ADDRESS": "CollectionPolicy.BY_DEFAULT",
                  "USER_ACTIONS": "CollectionPolicy.BY_DEFAULT",
                  "endpoint": {
                    "$ref": "RegularEndpoint"
                  }
                },
                "purposes": [
                  "DataCollectionPurpose.ANALYTICS"
                ]
              },
              {
                "ref": [
                  {
                    "explanation": "BitBoxApp uses Etherscan to query Ethereum and ERC20 token account information",
                    "url": "https://bitbox.swiss/policies/privacy-policy/"
                  }
                ],
                "byEntity": {
                  "$ref": "etherscan"
                },
                "dataCollection": {
                  "IP_ADDRESS": "CollectionPolicy.BY_DEFAULT",
                  "ACCOUNT_ADDRESS": "CollectionPolicy.BY_DEFAULT",
                  "BALANCE": "CollectionPolicy.BY_DEFAULT",
                  "endpoint": {
                    "$ref": "RegularEndpoint"
                  }
                },
                "purposes": [
                  "DataCollectionPurpose.CHAIN_DATA_LOOKUP",
                  "DataCollectionPurpose.ASSET_METADATA"
                ]
              }
            ]
          },
          "ONBOARDING_NEW": {
            "collected": [],
            "publishedOnchain": "NO_DATA_PUBLISHED_ONCHAIN"
          },
          "ONBOARDING_IMPORT": null,
          "APP_CONNECTION": "FLOW_NOT_SUPPORTED",
          "NATIVE_SWAP": "FLOW_NOT_SUPPORTED",
          "SEND_ETHER": {
            "collected": []
          },
          "SEND_USDC": null,
          "MAKE_TRANSACTION": {
            "collected": []
          }
        },
        "hardwarePrivacy": null,
        "privacyPolicy": "https://bitbox.swiss/policies/privacy-policy/",
        "transactionPrivacy": {
          "STEALTH_ADDRESSES": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://support.bitbox.swiss/en_US/ethereum-co/receive-eth-erc20-tokens",
                  "explanation": "No stealth-address receiving is offered; the BitBoxApp supports standard Bitcoin and basic Ethereum/ERC20 receiving only."
                }
              }
            ]
          },
          "PRIVACY_POOLS": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://github.com/BitBoxSwiss/bitbox-wallet-app/blob/master/CHANGELOG.md",
                  "explanation": "No Privacy Pools integration is documented in the BitBoxApp changelog or support materials."
                }
              }
            ]
          },
          "defaultFungibleTokenTransferMode": "PUBLIC"
        }
      },
      "profile": "WalletProfile.GENERIC",
      "security": {
        "accountRecovery": null,
        "bugBountyProgram": {
          "$call": "supported",
          "args": [
            {
              "ref": [
                {
                  "explanation": "At Shift Crypto, we strive towards excellence when it comes to the security and privacy of our products and believe that an open architecture is essential for keeping our users safe. However, even in time-proven security architectures, vulnerabilities can be found. This is why we release our code as open source. If you find a vulnerability, we would like to ask you to follow our bug bounty program for responsible disclosure.",
                  "url": "https://bitbox.swiss/bug-bounty-program/"
                }
              ],
              "availability": "BugBountyProgramAvailability.ACTIVE",
              "coverageBreadth": "FULL_SCOPE",
              "dateStarted": "2023-06-08",
              "disclosure": {
                "$ref": "notSupported"
              },
              "legalProtections": {
                "$ref": "notSupported"
              },
              "platform": "BugBountyPlatform.SELF_HOSTED",
              "rewards": {
                "$ref": "notSupported"
              },
              "upgradePathAvailable": true
            }
          ]
        },
        "duressResistance": {
          "duressMode": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.bitbox.swiss/en_US/optional-passphrase/understanding-bitbox02-optional-passphrase",
                  "explanation": "BitBox02's optional passphrase creates hidden wallets and can be used to set up a duress/decoy wallet with a small balance to reveal under coercion."
                }
              }
            ]
          }
        },
        "firmware": {
          "type": "FirmwareType.PASS",
          "customFirmware": null,
          "firmwareOpenSource": "FirmwareType.PASS",
          "reproducibleBuilds": "FirmwareType.PASS",
          "silentUpdateProtection": "FirmwareType.PASS"
        },
        "keysHandling": null,
        "lightClient": {
          "ethereumL1": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://bitbox.swiss/bitbox02/security-features/",
                  "explanation": "BitBoxApp connects to backend/RPC nodes (or a user's own full node for Bitcoin) and provides no trust-minimized Ethereum L1 light client verification."
                }
              }
            ]
          }
        },
        "publicSecurityAudits": null,
        "secureElement": null,
        "securityBestPractices": null,
        "supplyChainDIY": null,
        "supplyChainFactory": null,
        "transactionLegibility": {
          "ref": [
            {
              "explanation": "Independent video demonstration of BitBox02 signing capabilities",
              "url": "https://youtu.be/-m1jcBFS0dc?t=300"
            }
          ],
          "dataExtraction": {
            "EYES": true,
            "HASHES": false,
            "QRCODE": false
          },
          "detailsDisplayed": {
            "chain": "DataDisplayOptions.SHOWN_BY_DEFAULT",
            "from": "DataDisplayOptions.SHOWN_BY_DEFAULT",
            "gas": "DataDisplayOptions.SHOWN_BY_DEFAULT",
            "nonce": "DataDisplayOptions.NOT_IN_UI",
            "to": "DataDisplayOptions.SHOWN_BY_DEFAULT",
            "value": "DataDisplayOptions.SHOWN_BY_DEFAULT"
          },
          "erc7730": {
            "$ref": "notSupported"
          },
          "erc8213": null,
          "transactionSimulations": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://support.bitbox.swiss/en_US/ethereum-co/send-eth-erc20-tokens",
                  "explanation": "BitBoxApp shows raw transaction details for on-device confirmation but does not simulate/preview net balance changes (no Blockaid/Blowfish-style simulation)."
                }
              }
            ]
          }
        },
        "userSafety": null,
        "hardwareWalletSupport": {
          "$ref": "notApplicable"
        },
        "scamAlerts": {
          "scamUrlWarning": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://bitbox.swiss/bitbox02/security-features/",
                  "explanation": "BitBoxApp provides no known-malicious/phishing URL warning feature; its security model relies on manual on-device verification and its security-features page lists no such detection."
                }
              }
            ]
          },
          "sendTransactionWarning": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://support.bitbox.swiss/en_US/ethereum-co/send-eth-erc20-tokens",
                  "explanation": "BitBoxApp does not warn on risky sends such as address poisoning or unknown recipients, instead instructing users to manually verify all transaction details on the device screen."
                }
              }
            ]
          },
          "contractTransactionWarning": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://bitbox.swiss/bitbox02/security-features/",
                  "explanation": "No evidence BitBoxApp flags interactions with known-malicious contracts; its security-features and send docs describe only on-device detail verification, not contract reputation checks."
                }
              }
            ]
          }
        },
        "passkeyVerification": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://support.bitbox.swiss/en_US/using-the-bitbox02-as-a-fido-u2f-authenticator",
                "explanation": "The BitBox02 Multi edition functions as a FIDO U2F authenticator for two-factor authentication on websites like Google and GitHub."
              }
            }
          ]
        }
      },
      "selfSovereignty": {
        "interoperability": null,
        "permissionsManagement": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://support.bitbox.swiss/en_US/ethereum-co/connect-to-a-dapp-with-walletconnect",
                "explanation": "The BitBoxApp offers WalletConnect dapp connectivity but no built-in token-approval inspection/revocation UI; users are directed to external tools like Etherscan for approvals."
              }
            }
          ]
        },
        "transactionSubmission": {
          "l1": {
            "selfBroadcastViaSelfHostedNode": {
              "$call": "supported",
              "args": [
                {
                  "ref": {
                    "url": "https://support.bitbox.swiss/en_US/privacy/connecting-the-bitboxapp-to-your-own-full-node",
                    "explanation": "The BitBoxApp can connect to the user's own Bitcoin full node via an Electrum-compatible server for independent verification and broadcast."
                  }
                }
              ]
            }
          }
        }
      },
      "transparency": {
        "maintenance": null,
        "operationFees": null,
        "releaseTransparency": {
          "artifactSigning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.bitbox.swiss/en_US/verify-app-signature/verify-bitboxapp-signature-macos",
                  "explanation": "BitBoxApp installers are code-signed/notarized with published GPG .asc signatures, and firmware releases carry signed reproducibility assertions."
                }
              }
            ]
          },
          "dependencyLocking": null,
          "dependencyVulnerabilityScanning": null,
          "hasPublicChangelog": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://github.com/BitBoxSwiss/bitbox-wallet-app/blob/master/CHANGELOG.md",
                  "explanation": "BitBox publishes a public CHANGELOG.md for the BitBoxApp and a separate firmware changelog on GitHub."
                }
              }
            ]
          },
          "hermeticBuilds": null,
          "repositoryChangeControls": null,
          "reproducibleBuilds": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://github.com/BitBoxSwiss/bitbox02-firmware/blob/master/releases/README.md",
                  "explanation": "BitBox02 firmware is built reproducibly via Docker with fixed dependencies, allowing anyone to rebuild and match the official binary from a version tag."
                }
              }
            ]
          }
        },
        "reputation": null
      },
      "chainAbstraction": {
        "bridging": {
          "builtInBridging": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://github.com/BitBoxSwiss/bitbox-wallet-app/blob/master/CHANGELOG.md",
                  "explanation": "No native cross-chain bridging is documented in the BitBoxApp changelog or support hub."
                }
              }
            ]
          }
        }
      }
    },
    "variants": {
      "HARDWARE": true
    }
  }
