{
	"id": "nufi",
	"source": "software-wallets",
	"export": "nufi",
	"data": {
		"metadata": {
			"id": "nufi",
			"displayName": "NuFi",
			"tableName": "NuFi",
			"blurb": "Powerful wallet for powerful users.",
			"contributors": [
				{
					"$ref": "gabrielkerekes"
				},
				{
					"$ref": "mattmatt"
				}
			],
			"iconExtension": "svg",
			"lastUpdated": "2025-08-11",
			"urls": {
				"docs": [
					"https://nufi.gitbook.io/"
				],
				"extensions": [
					"https://chromewebstore.google.com/detail/nufi/gpnihlnnodeiiaakbikldcihojploeca"
				],
				"repositories": [
					"https://github.com/nufi-official/nufi"
				],
				"socials": {
					"discord": "https://discord.com/invite/jSyVPAXw3w",
					"reddit": "https://www.reddit.com/r/nufiofficial/",
					"x": "https://x.com/nufiwallet"
				},
				"websites": [
					"https://nu.fi"
				]
			}
		},
		"features": {
			"accountSupport": {
				"defaultAccountType": "AccountType.eoa",
				"eip7702": {
					"$call": "supported",
					"args": [
						{
							"ref": {
								"explanation": "The NuFi FAQ mentions the use the MetaMask DeleGator contract as smart account implementation.",
								"label": "NuFi support site",
								"url": "https://support.nu.fi/support/solutions/articles/80001178239"
							},
							"contract": {
								"$ref": "metamask7702DelegatorContract"
							}
						}
					]
				},
				"eoa": {
					"$call": "supported",
					"args": [
						{
							"ref": {
								"$ref": "refTodo"
							},
							"canExportPrivateKey": false,
							"keyDerivation": {
								"type": "BIP32",
								"canExportSeedPhrase": true,
								"derivationPath": "BIP44",
								"seedPhrase": "BIP39"
							}
						}
					]
				},
				"mpc": {
					"$ref": "notSupported"
				},
				"rawErc4337": {
					"$ref": "notSupported"
				},
				"safe": {
					"$ref": "notSupported"
				}
			},
			"addressResolution": {
				"ref": {
					"$ref": "refTodo"
				},
				"chainSpecificAddressing": {
					"erc7828": {
						"$ref": "notSupported"
					},
					"erc7831": {
						"$ref": "notSupported"
					}
				},
				"nonChainSpecificEnsResolution": {
					"$ref": "notSupported"
				}
			},
			"chainAbstraction": null,
			"chainConfigurability": null,
			"ecosystem": {
				"delegation": {
					"duringEOACreation": "NO",
					"duringEOAImport": "NO",
					"duringFirst7702Operation": {
						"$call": "supported",
						"args": [
							{
								"type": "DELEGATION_BUNDLED_WITH_OTHER_OPERATIONS",
								"nonDelegationTransactionDetailsIdenticalToNormalFlow": true
							}
						]
					},
					"fee": {
						"crossChainGas": {
							"$ref": "notSupported"
						},
						"walletSponsored": {
							"$ref": "notSupported"
						}
					}
				}
			},
			"integration": {
				"browser": {
					"1193": {
						"$ref": "featureSupported"
					},
					"2700": {
						"$ref": "featureSupported"
					},
					"6963": {
						"$ref": "featureSupported"
					},
					"ref": {
						"$ref": "refTodo"
					}
				},
				"walletCall": {
					"$call": "supported",
					"args": [
						{
							"ref": {
								"$ref": "refTodo"
							},
							"atomicMultiTransactions": {
								"$ref": "featureSupported"
							}
						}
					]
				}
			},
			"licensing": {
				"type": "LicensingType.SINGLE_WALLET_REPO_AND_LICENSE",
				"walletAppLicense": {
					"ref": {
						"$ref": "refNotNecessary"
					},
					"license": "SourceNotAvailableLicense.PROPRIETARY"
				}
			},
			"monetization": {
				"ref": {
					"$ref": "refTodo"
				},
				"revenueBreakdownIsPublic": false,
				"strategies": {
					"donations": false,
					"ecosystemGrants": false,
					"governanceTokenLowFloat": false,
					"governanceTokenMostlyDistributed": false,
					"hiddenConvenienceFees": false,
					"publicOffering": false,
					"selfFunded": true,
					"transparentConvenienceFees": false,
					"ventureCapital": false
				}
			},
			"multiAddress": {
				"$ref": "featureSupported"
			},
			"privacy": {
				"analytics": {
					"crashReports": null,
					"usage": null
				},
				"appIsolation": null,
				"dataCollection": null,
				"privacyPolicy": "https://nu.fi/privacy-and-cookies-policy",
				"transactionPrivacy": {
					"defaultFungibleTokenTransferMode": "PUBLIC",
					"STEALTH_ADDRESSES": {
						"$ref": "notSupported"
					},
					"TORNADO_CASH_NOVA": {
						"$ref": "notSupported"
					},
					"PRIVACY_POOLS": {
						"$ref": "notSupported"
					},
					"RAILGUN": {
						"$ref": "notSupported"
					}
				}
			},
			"profile": "WalletProfile.GENERIC",
			"security": {
				"accountRecovery": null,
				"bugBountyProgram": null,
				"duressResistance": null,
				"hardwareWalletSupport": {
					"ref": {
						"$ref": "refTodo"
					},
					"wallets": {
						"LEDGER": {
							"$call": "supported",
							"args": [
								{
									"connectionTypes": [
										"HardwareWalletConnection.webUSB",
										"HardwareWalletConnection.bluetooth"
									]
								}
							]
						},
						"TREZOR": {
							"$call": "supported",
							"args": [
								{
									"connectionTypes": [
										"HardwareWalletConnection.webUSB"
									]
								}
							]
						},
						"KEYSTONE": {
							"$call": "supported",
							"args": [
								{
									"connectionTypes": [
										"HardwareWalletConnection.QR"
									]
								}
							]
						},
						"GRIDPLUS": {
							"$call": "supported",
							"args": [
								{
									"connectionTypes": [
										"HardwareWalletConnection.webUSB"
									]
								}
							]
						},
						"ONEKEY": {
							"$call": "supported",
							"args": [
								{
									"connectionTypes": [
										"HardwareWalletConnection.webUSB"
									]
								}
							]
						},
						"BITBOX": {
							"$call": "supported",
							"args": [
								{
									"connectionTypes": [
										"HardwareWalletConnection.webUSB"
									]
								}
							]
						}
					}
