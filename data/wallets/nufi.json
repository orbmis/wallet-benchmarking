			"accountSupport": {
				"defaultAccountType": "AccountType.eoa",
				"eip7702": {
					"$call": "supported",
					"args": [
						{
							"ref": {
								"explanation": "The NuFi FAQ mentions the use the MetaMask DeleGator contract as smart account implementation.",
								"label": "NuFi support site",
								"url": "https://support.nu.fi/support/solutions/articles/80001178239"
							},
							"contract": {
								"$ref": "metamask7702DelegatorContract"
							}
						}
					]
				},
				"eoa": {
					"$call": "supported",
					"args": [
						{
							"ref": [
								{
									"explanation": "NuFi's restore guide says existing wallets can be restored with a 12-, 15-, or 24-word seed phrase or SLIP39 recovery shares, and accounts are derived from the seed phrase.",
									"url": "https://support.nu.fi/support/solutions/articles/80000951672-restore-an-existing-wallet"
								},
								{
									"explanation": "NuFi's backup guide says users can reveal and write down a 24-word recovery phrase, and restore the wallet with that phrase.",
									"url": "https://support.nu.fi/support/solutions/articles/80001148285-back-up-or-restore-your-wallet"
								}
							],
							"canExportPrivateKey": false,
							"keyDerivation": {
								"type": "BIP32",
								"canExportSeedPhrase": true,
								"derivationPath": "BIP44",
								"seedPhrase": "BIP39"
							}
						}
					]
				},
				"mpc": {
					"$ref": "notSupported"
				},
				"rawErc4337": {
					"$ref": "notSupported"
				},
				"safe": {
					"$ref": "notSupported"
