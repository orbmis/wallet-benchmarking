						"selfBroadcastViaDirectGossip": {
							"$ref": "notSupported"
						},
						"selfBroadcastViaSelfHostedNode": {
							"$ref": "notSupported"
						}
					},
					"l2": {
						"ref": {
							"$ref": "refTodo"
						},
						"arbitrum": null,
						"opStack": null
