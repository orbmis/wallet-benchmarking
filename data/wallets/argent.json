						"explanation": "Argent X is a browser extension wallet for Starknet dapps.",
						"url": "https://github.com/argentlabs/argent-x"
					}
				},
				"walletCall": null
			},
			"licensing": {
				"type": "LicensingType.MULTIPLE_WALLET_REPOS",
