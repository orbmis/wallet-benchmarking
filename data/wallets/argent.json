						"$call": "notSupportedWithRef",
						"args": [
							{
								"ref": {
									"explanation": "Argent public support pages reviewed for this entry did not show a malicious-contract registry warning feature.",
									"url": "https://support.argent.xyz/"
								}
							}
						]
