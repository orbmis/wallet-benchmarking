{
	"id": "argent",
	"source": "software-wallets",
	"export": "argent",
	"data": {
		"metadata": {
			"id": "argent",
			"displayName": "Argent",
			"tableName": "Argent",
			"blurb": "Argent is a smart-contract wallet for Starknet and Ethereum with guardian-based recovery.",
			"contributors": [],
			"iconExtension": "png",
			"lastUpdated": "2026-06-07",
			"urls": {
				"docs": [
					"https://support.argent.xyz/"
				],
				"extensions": [
					"https://chromewebstore.google.com/detail/argent-x/dlcobpjiigpikoobohmabehhmhfoodbb"
				],
				"repositories": [
					"https://github.com/argentlabs/argent-contracts",
					"https://github.com/argentlabs/argent-x"
				],
				"websites": [
					"https://www.argent.xyz/"
				]
			}
		},
		"features": {
			"accountSupport": {
				"defaultAccountType": "AccountType.rawErc4337",
				"eip7702": {
					"$ref": "notSupported"
				},
				"eoa": {
					"$ref": "notSupported"
				},
				"mpc": {
					"$ref": "notSupported"
				},
				"rawErc4337": {
					"$call": "supported",
					"args": [
						{
							"ref": {
								"explanation": "Argent support says Argent is a smart contract wallet available on Ethereum and Starknet.",
								"url": "https://support.argent.xyz/hc/en-us/articles/360022517332-What-is-a-smart-contract-wallet"
							},
							"contract": "UNKNOWN",
							"controllingSharesInSelfCustodyByDefault": "YES",
							"keyRotationTransactionGeneration": "TransactionGenerationCapability.USING_OPEN_SOURCE_STANDALONE_APP",
							"tokenTransferTransactionGeneration": "TransactionGenerationCapability.USING_PROPRIETARY_STANDALONE_APP"
						}
					]
				},
				"safe": {
					"$ref": "notSupported"
				}
			},
			"addressResolution": {
				"ref": {
					"explanation": "Argent focuses on Starknet account addresses and usernames; no ENS recipient-resolution feature was found in current public docs.",
					"url": "https://support.argent.xyz/"
				},
				"chainSpecificAddressing": {
					"erc7828": {
						"$ref": "notSupported"
					},
					"erc7831": {
						"$ref": "notSupported"
					}
				},
				"nonChainSpecificEnsResolution": {
					"$call": "notSupportedWithRef",
					"args": [
						{
							"ref": {
								"explanation": "Targeted review of Argent support pages found no ENS resolution feature for recipient entry.",
								"url": "https://support.argent.xyz/"
							}
						}
					]
				}
			},
			"chainAbstraction": {
				"bridging": {
					"builtInBridging": {
						"$call": "supported",
						"args": [
							{
								"ref": {
									"explanation": "Argent supports adding funds and moving assets into Starknet from supported networks as part of the wallet onboarding and funding flow.",
									"url": "https://support.argent.xyz/"
								}
							}
						]
					},
					"suggestedBridging": null
				},
				"crossChainBalances": {
					"ref": {
						"explanation": "Argent presents portfolio assets in the mobile and Argent X wallet experience.",
						"url": "https://www.argent.xyz/"
					},
					"globalAccountValue": {
						"$ref": "featureSupported"
