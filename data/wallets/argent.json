				]
			},
			"privacy": {
				"analytics": {
					"crashReports": {
						"$call": "supported",
						"args": [
							{
								"ref": {
									"explanation": "Argent support documents that Argent collects data for operating and improving the wallet, with more detail in its privacy policy.",
									"url": "https://support.argent.xyz/hc/en-us/articles/360006211718-What-data-does-Argent-collect"
								}
							}
						]
					},
					"usage": {
						"$call": "supported",
						"args": [
							{
								"ref": {
									"explanation": "Argent support documents wallet data collection and points users to the privacy policy for details.",
									"url": "https://support.argent.xyz/hc/en-us/articles/360006211718-What-data-does-Argent-collect"
								}
							}
						]
