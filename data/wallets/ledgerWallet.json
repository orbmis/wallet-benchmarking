{
  "id": "ledgerWallet",
  "source": "hardware-wallets",
  "export": "ledgerWallet",
  "data": {
    "metadata": {
      "$ref": "ledgerWalletMetadata"
    },
    "features": {
      "accountSupport": {
        "eoa": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://www.ledger.com/academy/glossary/externally-owned-account-eoa",
                "explanation": "Ledger's own Academy page identifies an EOA as what users create when setting up a wallet with a Ledger signer, confirming EOA account support."
              }
            }
          ]
        },
        "mpc": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://www.ledger.com/academy/glossary/externally-owned-account-eoa",
                "explanation": "Ledger derives and stores a single private key on its secure element; no MPC/threshold-signature product is described."
              }
            }
          ]
        },
        "rawErc4337": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://www.ledger.com/academy/topics/ledgersolutions/10-years-of-ledger-secure-self-custody-for-all",
                "explanation": "Ledger's hardware + Ledger Live secure EOA private keys; no native ERC-4337 smart account creation is offered as a Ledger product."
              }
            }
          ]
        },
        "safe": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://www.ledger.com/academy/topics/ledgersolutions/10-years-of-ledger-secure-self-custody-for-all",
                "explanation": "Ledger can be a signer within a Safe multisig, but Ledger Live does not natively create or provide Safe accounts as its own product."
              }
            }
          ]
        },
        "eip7702": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://github.com/LedgerHQ/app-ethereum/blob/master/CHANGELOG.md",
                "explanation": "Ledger's app-ethereum v1.17.0 (2025-05-05) added EIP-7702 authorization signing and Type 4 transaction signing on Flex, Stax, Nano X, and Nano S Plus."
              }
            }
          ]
        }
      },
      "appConnectionSupport": {
        "$call": "supported",
        "args": [
          {
            "ref": "https://support.ledger.com/article/360018444599-zd",
            "requiresManufacturerConsent": {
              "type": "FEATURES_GATED_BY_MANUFACTURER",
              "ref": {
                "explanation": "Software wallet developers are required to register with Ledger's partner program before their software wallet becomes able to display clear signing data on Ledger devices.",
                "label": "Ledger Developer Portal",
                "url": "https://developers.ledger.com/docs/clear-signing/for-wallets"
              }
            },
            "supportedConnections": {
              "METAMASK": true,
              "RABBY": true,
              "FRAME": true,
              "OTHER": true,
              "VENDOR_OPEN_SOURCE_APP": true
            }
          }
        ]
      },
      "licensing": {
        "walletAppLicense": {
          "license": "FOSSLicense.MIT",
          "ref": {
            "url": "https://github.com/LedgerHQ/ledger-live-desktop/blob/develop/LICENSE",
            "explanation": "The Ledger Live desktop app LICENSE file is the MIT License, copyright Ledger."
          }
        }
      },
      "monetization": {
        "ref": [
          {
            "explanation": "Ledger raises $380 million to make digital assets more secure and accessible to everyone",
            "url": "https://www.businesswire.com/news/home/20210609005985/en/Ledger-completes-a-%24380-million-Series-C-fundraising-valuing-the-company-at-more-than-%241.5-billion-to-strengthen-its-position-as-the-leading-secure-gateway-to-digital-assets"
          }
        ],
        "revenueBreakdownIsPublic": false,
        "strategies": {
          "donations": null,
          "ecosystemGrants": null,
          "governanceTokenLowFloat": null,
          "governanceTokenMostlyDistributed": null,
          "hiddenConvenienceFees": null,
          "publicOffering": null,
          "selfFunded": null,
          "transparentConvenienceFees": null,
          "ventureCapital": true
        }
      },
      "multiAddress": {
        "$call": "supported",
        "args": [
          {
            "ref": {
              "url": "https://support.ledger.com/article/4404389645329-zd",
              "explanation": "Ledger Live lets users add multiple Ethereum accounts, each generating a unique BIP-44-derived address."
            }
          }
        ]
      },
      "privacy": {
        "analytics": {
          "crashReports": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://www.ledger.com/privacy-policy",
                  "explanation": "Ledger Live sends crash/error diagnostic reports (a separate 'Report bugs' toggle exists in Settings > Help alongside Analytics), so crash reports are sent by default."
                }
              }
            ]
          },
          "usage": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://www.ledger.com/privacy-policy",
                  "explanation": "Ledger Live collects anonymous usage/product analytics by default with a toggle under Settings > Help > Analytics, so it does send usage telemetry."
                }
              }
            ]
          }
        },
        "dataCollection": null,
        "hardwarePrivacy": null,
        "privacyPolicy": "https://ledger.com/privacy-policy",
        "transactionPrivacy": {
          "STEALTH_ADDRESSES": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://www.ledger.com/how-to-keep-yourself-private-in-the-blockchain-world",
                  "explanation": "No official Ledger documentation indicates support for stealth-address receiving in Ledger Live or the devices."
                }
              }
            ]
          },
          "PRIVACY_POOLS": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://www.ledger.com/how-to-keep-yourself-private-in-the-blockchain-world",
                  "explanation": "There is no evidence in Ledger's official materials of any Privacy Pools integration in Ledger Live or its devices."
                }
              }
            ]
          },
          "defaultFungibleTokenTransferMode": "PUBLIC"
        }
      },
      "profile": "WalletProfile.GENERIC",
      "security": {
        "accountRecovery": null,
        "bugBountyProgram": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "$ref": "refTodo"
              },
              "availability": "BugBountyProgramAvailability.ACTIVE",
              "coverageBreadth": "FULL_SCOPE",
              "dateStarted": "2020-03-07",
              "disclosure": {
                "$call": "supported",
                "args": [
                  {
                    "numberOfDays": 90
                  }
                ]
              },
              "legalProtections": {
                "$call": "supported",
                "args": [
                  {
                    "type": "LegalProtectionType.SAFE_HARBOR",
                    "ref": [
                      {
                        "explanation": "Ledger commits that security researchers reporting bugs will be protected from legal liability, so long as they follow responsible disclosure guidelines and principles.",
                        "url": "https://donjon.ledger.com/bounty"
                      }
                    ]
                  }
                ]
              },
              "platform": "BugBountyPlatform.SELF_HOSTED",
              "rewards": {
                "$ref": "notSupported"
              },
              "upgradePathAvailable": true
            }
          ]
        },
        "duressResistance": {
          "duressMode": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://www.ledger.com/academy/passphrase-an-advanced-security-feature",
                  "explanation": "Ledger's passphrase feature creates hidden wallets for plausible deniability, letting a user reveal only a decoy standard account under coercion."
                }
              }
            ]
          }
        },
        "firmware": null,
        "keysHandling": null,
        "lightClient": {
          "ethereumL1": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://support.ledger.com/article/how-to-enhance-the-safety-of-your-ethereum-transactions-with-transaction-check",
                  "explanation": "Ledger Live relies on standard/third-party RPC providers and Ledger's own backend rather than a trust-minimized Ethereum L1 light client; no such feature is documented."
                }
              }
            ]
          }
        },
        "publicSecurityAudits": [
          {
            "ref": {
              "url": "https://www.ledger.com/setting-a-new-standard-ledger-nano-s-becomes-the-first-and-only-certified-hardware-wallet-on-the-market",
              "explanation": "Ledger Nano S v1.5.1 ANSSI CSPN first-level security certification, ANSSI-CSPN-2019/03."
            },
            "auditDate": "2019-02-14",
            "unpatchedFlaws": "NONE"
          },
          {
            "ref": {
              "url": "https://messervices.cyber.gouv.fr/visas/ANSSI-CSPN-2023-13-rapport.pdf",
              "explanation": "Ledger Nano S Plus (SE 1.0.4) ANSSI CSPN certification report, ANSSI-CSPN-2023/13 (evaluated by EDSI)."
            },
            "auditDate": "2023-07-21",
            "unpatchedFlaws": "NONE"
          },
          {
            "ref": {
              "url": "https://messervices.cyber.gouv.fr/visas/ANSSI-CSPN-2023-17-rapport.pdf",
              "explanation": "Ledger Nano X (SE 2.1.0) ANSSI CSPN certification report, ANSSI-CSPN-2023/17 (evaluated by EDSI)."
            },
            "auditDate": "2023-07-21",
            "unpatchedFlaws": "NONE"
          }
        ],
        "secureElement": {
          "$call": "supported",
          "args": [
            {
              "ref": [
                {
                  "explanation": "Ledger devices have an EAL 5+ or an EAL 6+ certification depending on which device you get.",
                  "url": "https://www.ledger.com/academy/security/the-secure-element-whistanding-security-attacks"
                }
              ],
              "secureElementType": "SecureElementType.EAL_6_PLUS"
            }
          ]
        },
        "securityBestPractices": null,
        "supplyChainDIY": null,
        "supplyChainFactory": null,
        "transactionLegibility": {
          "ref": [
            {
              "explanation": "Independent video demonstration of Ledger's signing implementation on a Safe.",
              "url": "https://youtu.be/9YmPWxAvKYY?t=1722"
            }
          ],
          "dataExtraction": {
            "EYES": true,
            "HASHES": false,
            "QRCODE": false
          },
          "detailsDisplayed": {
            "$ref": "displaysFullTransactionDetails"
          },
          "erc7730": {
            "$ref": "notSupported"
          },
          "erc8213": null,
          "transactionSimulations": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://www.blockaid.io/blog/how-blockaid-helps-ledgers-transaction-check-mitigate-blind-signing-risks",
                  "explanation": "Ledger's Transaction Check simulates the transaction and validates its outcomes (via Blockaid/Tenderly/Cyvers) before signing."
                }
              }
            ]
          }
        },
        "userSafety": null,
        "hardwareWalletSupport": {
          "$ref": "notApplicable"
        },
        "scamAlerts": {
          "scamUrlWarning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://www.blockaid.io/blog/how-blockaid-helps-ledgers-transaction-check-mitigate-blind-signing-risks",
                  "explanation": "Ledger Live's Transaction Check (powered by Blockaid) flags interactions with questionable dApps/scam sites as potential risks or critical threats before signing."
                }
              }
            ]
          },
          "sendTransactionWarning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.ledger.com/article/how-to-enhance-the-safety-of-your-ethereum-transactions-with-transaction-check",
                  "explanation": "Transaction Check flags sending assets to an unknown address as a potential risk before the transaction is signed."
                }
              }
            ]
          },
          "contractTransactionWarning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://www.blockaid.io/blog/how-blockaid-helps-ledgers-transaction-check-mitigate-blind-signing-risks",
                  "explanation": "Transaction Check via Blockaid identifies transactions involving malicious contracts or stolen funds and flags them as critical threats."
                }
              }
            ]
          }
        },
        "passkeyVerification": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://www.ledger.com/blog/strengthen-the-security-of-your-accounts-with-webauthn",
                "explanation": "Ledger devices run a Security Key application implementing FIDO U2F/FIDO2/WebAuthn for use as a 2FA/MFA authentication factor."
              }
            }
          ]
        }
      },
      "selfSovereignty": {
        "interoperability": null,
        "permissionsManagement": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://support.ledger.com/article/8700644160925-zd",
                "explanation": "Ledger Live integrates Revoke.cash to let users inspect and revoke token approvals without leaving the app."
              }
            }
          ]
        },
        "transactionSubmission": {
          "l1": {
            "selfBroadcastViaSelfHostedNode": {
              "$call": "supported",
              "args": [
                {
                  "ref": {
                    "url": "https://github.com/LedgerHQ/satstack",
                    "explanation": "Ledger's open-source SatStack lets Ledger Live connect to a user's own Bitcoin full node to broadcast transactions."
                  }
                }
              ]
            }
          }
        }
      },
      "transparency": {
        "maintenance": null,
        "operationFees": null,
        "releaseTransparency": {
          "artifactSigning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://www.ledger.com/academy/topics/ledgersolutions/is-ledger-open-source",
                  "explanation": "Ledger firmware/OS and apps are cryptographically signed and verified by the device's genuine check before install."
                }
              }
            ]
          },
          "dependencyLocking": null,
          "dependencyVulnerabilityScanning": null,
          "hasPublicChangelog": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://github.com/LedgerHQ/ledger-live/blob/develop/apps/ledger-live-desktop/CHANGELOG.md",
                  "explanation": "Ledger publishes a public CHANGELOG.md and GitHub Releases for Ledger Live, plus a 'What's new' support page."
                }
              }
            ]
          },
          "hermeticBuilds": null,
          "repositoryChangeControls": null,
          "reproducibleBuilds": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://www.ledger.com/blog-ledger-is-95-opensource-why-not-100",
                  "explanation": "Ledger's Secure Element firmware is closed-source under STMicroelectronics NDA and is not published as reproducible builds."
                }
              }
            ]
          }
        },
        "reputation": null
      },
      "chainAbstraction": {
        "bridging": {
          "builtInBridging": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.ledger.com/article/swap-tokens-across-blockchains-with-lifi-in-ledger-live",
                  "explanation": "Ledger Live offers native cross-chain bridging/swaps via the integrated LI.FI aggregator."
                }
              }
            ]
          }
        },
        "crossChainBalances": {
          "globalAccountValue": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://www.ledger.com/ledger-live/",
                  "explanation": "The Ledger Wallet/Live Home tab aggregates total balance across every account and network into a single unified value view."
                }
              }
            ]
          }
        }
      },
      "addressResolution": {
        "nonChainSpecificEnsResolution": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://www.ledger.com/blog/ledger-now-supports-ens-domain-adresses",
                "explanation": "Ledger Live resolves ENS names in the send flow, with the mapping cryptographically verified on the hardware device."
              }
            }
          ]
        }
      }
    },
    "variants": {
      "HARDWARE": true
    }
  }
}