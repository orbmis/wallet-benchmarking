              "ref": {
                "explanation": "Brave Wallet creation asks users to back up a 12-word recovery phrase for self-custody wallet access.",
                "url": "https://support.brave.com/hc/en-us/articles/12753544357645-Creating-your-Brave-Wallet"
              },
              "canExportPrivateKey": true,
              "keyDerivation": {
                "type": "BIP32",
                "canExportSeedPhrase": true,
                "derivationPath": "BIP44",
                "seedPhrase": "BIP39"
              }
            }
          ]
        },
        "mpc": {
          "$ref": "notSupported"
        },
        "rawErc4337": {
          "$ref": "notSupported"
        },
        "safe": {
          "$ref": "notSupported"
        }
