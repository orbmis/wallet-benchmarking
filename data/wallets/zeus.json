										"url": "https://github.com/greekfetacheese/zeus#features"
									}
								],
								"afterSingleAction": "comprehensiveFeesShownByDefault.afterSingleAction",
								"byDefault": "comprehensiveFeesShownByDefault.byDefault",
								"fullySponsored": "comprehensiveFeesShownByDefault.fullySponsored"
							}
						]
					},
					"ethL1Transfer": {
						"$call": "supported",
						"args": [
							{
								"ref": [
									{
										"explanation": "Zeus performs local EVM simulations to show exact outcomes including fees.",
										"url": "https://github.com/greekfetacheese/zeus#features"
									}
								],
								"afterSingleAction": "comprehensiveFeesShownByDefault.afterSingleAction",
								"byDefault": "comprehensiveFeesShownByDefault.byDefault",
								"fullySponsored": "comprehensiveFeesShownByDefault.fullySponsored"
							}
						]
					},
					"uniswapUSDCToEtherSwap": {
						"$call": "supported",
						"args": [
							{
								"ref": [
									{
										"explanation": "Zeus performs local EVM simulations to show exact outcomes but it does not show the fees if any.",
										"url": "https://github.com/greekfetacheese/zeus#features"
									}
								],
								"afterSingleAction": "comprehensiveFeesShownByDefault.afterSingleAction",
								"byDefault": "comprehensiveFeesShownByDefault.byDefault",
								"fullySponsored": "comprehensiveFeesShownByDefault.fullySponsored"
							}
						]
