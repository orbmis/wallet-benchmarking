			"id": "zeus",
			"displayName": "Zeus",
			"tableName": "Zeus",
			"blurb": "Zeus is a truly seedless and decentralized self-custodial Ethereum wallet.",
			"contributors": [
				{
					"$ref": "greekfetacheese"
				}
			],
			"iconExtension": "svg",
			"lastUpdated": "2026-01-12",
			"urls": {
				"docs": [
					"https://github.com/greekfetacheese/zeus"
				],
				"repositories": [
					"https://github.com/greekfetacheese/zeus"
				],
				"websites": [
					"https://github.com/greekfetacheese/zeus"
				]
			}
		},
		"features": {
			"accountSupport": {
				"defaultAccountType": "AccountType.eoa",
				"eip7702": {
					"$ref": "notSupported"
				},
				"eoa": {
					"$call": "supported",
					"args": [
						{
							"ref": [
								{
									"explanation": "Zeus derives a Hierarchical Deterministic Wallet from a username and password using the BIP32 standard. Users can also import wallets using either a 12-24 word phrase or a private key.",
									"url": "https://github.com/greekfetacheese/zeus#how-wallet-management-work-in-zeus"
								}
							],
							"canExportPrivateKey": true,
							"keyDerivation": {
								"type": "BIP32",
								"canExportSeedPhrase": false,
								"derivationPath": "BIP44",
								"seedPhrase": "BIP39"
							}
						}
					]
				},
				"mpc": {
					"$ref": "notSupported"
				},
				"rawErc4337": {
					"$ref": "notSupported"
				},
				"safe": {
					"$ref": "notSupported"
				}
			},
			"addressResolution": {
				"ref": {
					"explanation": "Zeus's send UI validates recipients by parsing the input as an Ethereum address with `Address::from_str`; repository search found no ENS, namehash, resolver, or Universal Resolver implementation.",
					"url": "https://github.com/greekfetacheese/zeus/blob/1eebac5c3dfd740aa6b87d915b495b98a3f140c4/src/gui/ui/send_crypto.rs"
				},
				"chainSpecificAddressing": {
					"erc7828": null,
					"erc7831": null
				},
				"nonChainSpecificEnsResolution": {
					"$call": "notSupportedWithRef",
					"args": [
						{
							"ref": {
								"explanation": "The Zeus send flow checks recipient input with `Address::from_str`, so non-address names such as ENS names are rejected as invalid recipients rather than resolved.",
								"url": "https://github.com/greekfetacheese/zeus/blob/1eebac5c3dfd740aa6b87d915b495b98a3f140c4/src/gui/ui/send_crypto.rs"
							}
						}
					]
				}
			},
