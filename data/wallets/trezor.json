            "ref": "https://trezor.io/guides/third-party-wallet-apps/third-party-wallet-apps-dapps",
            "requiresManufacturerConsent": null,
            "supportedConnections": {
              "VENDOR_OPEN_SOURCE_APP": true,
              "METAMASK": true,
              "RABBY": true,
              "AMBIRE": true,
              "FRAME": true,
              "OTHER": true
            }
          }
        ]
      },
