          "id": "trezor-safe-5",
          "name": "Trezor Safe 5",
          "isFlagship": true,
          "url": "https://trezor.io/trezor-safe-5"
        },
        {
          "id": "trezor-safe-3",
          "name": "Trezor Safe 3",
          "isFlagship": false,
          "url": "https://trezor.io/trezor-safe-3"
