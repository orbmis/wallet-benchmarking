{
  "id": "keycard-shell",
  "source": "hardware-wallets",
  "export": "keycardShell",
  "data": {
    "metadata": {
      "id": "keycard-shell",
      "displayName": "Keycard Shell",
      "tableName": "Keycard Shell",
      "blurb": "Keycard Shell is a modular, fully open-source, air-gapped hardware wallet that signs via QR codes (ERC-4527). It has a built-in keypad, display, and camera, optional USB (can be turned off), and uses removable Keycards for secure key storage and backups. Keycard is a BIP-32 HD wallet running on JavaCard with EAL6+ secure element. Supports BIP-39 and SLIP-39 seed phrases.",
      "contributors": [
        {
          "$ref": "phift"
        },
        {
          "$ref": "mmlado"
        }
      ],
      "hardwareWalletManufactureType": "HardwareWalletManufactureType.FACTORY_MADE",
      "hardwareWalletModels": [
        {
          "id": "keycard-shell",
          "name": "Keycard Shell",
          "isFlagship": true,
          "url": "https://get.keycard.tech/pages/keycard-shell"
        }
      ],
      "iconExtension": "svg",
      "lastUpdated": "2026-05-02",
      "urls": {
        "docs": [
          "https://keycard.tech/en/developers/overview",
          "https://keycard.tech/start/shell"
        ],
        "repositories": [
          "https://github.com/keycard-tech/keycard-shell",
          "https://github.com/keycard-tech/status-keycard",
          "https://github.com/keycard-tech/eth-abi-repo"
        ],
        "socials": {
          "x": "https://x.com/Keycard_"
        },
        "websites": [
          "https://keycard.tech/",
          "https://shell.keycard.tech/"
        ]
      }
    },
    "features": {
      "accountSupport": {
        "eoa": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://keycard.tech/pages/keycard-shell",
                "explanation": "Keycard Shell supports Ethereum and all EVM chains as a BIP-32 HD wallet deriving and signing standard Ethereum EOA keys."
              }
            }
          ]
        },
        "mpc": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://docs.keycard.tech/en/developers/overview",
                "explanation": "Keycard Shell is a BIP-32 HD wallet where the secure element is the signer; a traditional hardware architecture, not MPC."
              }
            }
          ]
        },
        "rawErc4337": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://keycard.tech/pages/keycard-shell",
                "explanation": "Keycard Shell is an air-gapped hardware signer (ERC-4527 QR) used with third-party wallets; it does not natively provide ERC-4337 accounts."
              }
            }
          ]
        },
        "safe": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://keycard.tech/pages/keycard-shell",
                "explanation": "Keycard Shell is a pure hardware signing device; Safe accounts would be managed through a connected third-party app, not created natively."
              }
            }
          ]
        },
        "eip7702": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://github.com/keycard-tech/keycard-shell/releases",
                "explanation": "Keycard Shell firmware releases through v1.3.0 (May 2026) contain no mention of EIP-7702; it focuses on ERC-4527 QR signing."
              }
            }
          ]
        }
      },
      "appConnectionSupport": {
        "$call": "supported",
        "args": [
          {
            "ref": [
