{
  "id": "keystone",
  "source": "hardware-wallets",
  "export": "keystoneWallet",
  "data": {
    "metadata": {
      "id": "keystone",
      "displayName": "Keystone Wallet",
      "tableName": "Keystone",
      "blurb": "Keystone Wallet is a self-custodial hardware wallet that provides secure private key storage. It uses QR codes for air-gapped transaction signing.",
      "contributors": [
        {
          "$ref": "nconsigny"
        },
        {
          "$ref": "patrickalphac"
        },
        {
          "$ref": "mattmatt"
        }
      ],
      "hardwareWalletManufactureType": "HardwareWalletManufactureType.FACTORY_MADE",
      "hardwareWalletModels": [
        {
          "id": "keystone-pro",
          "name": "Keystone Pro",
          "isFlagship": true,
          "url": "https://keyst.one/pro"
        }
      ],
      "iconExtension": "svg",
      "lastUpdated": "2025-03-12",
      "urls": {
        "docs": [
          "https://support.keyst.one/"
        ],
        "repositories": [
          "https://github.com/KeystoneHQ"
        ],
        "socials": {
          "facebook": "https://web.facebook.com/people/Keystone-Wallet/",
          "farcaster": "https://farcaster.xyz/keystonewallet",
          "reddit": "https://www.reddit.com/r/KeystoneWallet/",
          "telegram": "https://t.me/KeystoneWallet",
          "x": "https://x.com/KeystoneWallet",
          "youtube": "https://www.youtube.com/channel/UCaReIdawwYPPcyWGoNunF7g"
        },
        "websites": [
          "https://keyst.one/"
        ]
      }
    },
    "features": {
      "accountSupport": {
        "eoa": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://support.keyst.one/advanced-features/change-the-derivation-path-of-addresses",
                "explanation": "Keystone natively derives Ethereum accounts via BIP-44 (coin type 60') and signs standard EOA transactions."
              }
            }
          ]
        },
        "mpc": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://keyst.one/",
                "explanation": "Keystone is a traditional air-gapped hardware wallet using BIP-32/39/44 derivation with no MPC architecture described."
              }
            }
          ]
        },
        "rawErc4337": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://keyst.one/",
                "explanation": "Keystone is an air-gapped signer that connects to third-party wallets; its own product does not natively create ERC-4337 smart accounts."
              }
            }
          ]
        },
        "safe": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://support.keyst.one/3rd-party-wallets/defi-dapp-with-keystone/gnosis-safe",
                "explanation": "Keystone acts as a co-signer/owner key in Safe setups created via the Safe web app; the Safe account is provided by Safe's platform, not natively by Keystone."
              }
            }
          ]
        },
        "eip7702": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://github.com/KeystoneHQ/keystone3-firmware/releases",
                "explanation": "Keystone3 firmware release notes (through v3.0.0) contain no mention of EIP-7702 or Type 4 transaction support."
              }
            }
          ]
        }
      },
      "appConnectionSupport": {
        "$call": "supported",
        "args": [
          {
            "ref": "https://guide.keyst.one/docs/keystone",
            "requiresManufacturerConsent": null,
            "supportedConnections": {
              "METAMASK": true,
              "RABBY": true,
              "OTHER": true
            }
          }
        ]
      },
      "licensing": {
        "walletAppLicense": {
          "license": "MIT",
          "ref": {
            "url": "https://github.com/KeystoneHQ/keystone3-firmware/blob/master/LICENSE",
            "explanation": "The Keystone 3 firmware repository LICENSE file is the MIT License."
          }
        }
      },
      "monetization": {
        "ref": {
          "$ref": "refTodo"
        },
        "revenueBreakdownIsPublic": false,
        "strategies": {
          "donations": null,
          "ecosystemGrants": null,
          "governanceTokenLowFloat": null,
          "governanceTokenMostlyDistributed": null,
          "hiddenConvenienceFees": null,
          "publicOffering": null,
          "selfFunded": null,
          "transparentConvenienceFees": null,
          "ventureCapital": null
        }
      },
      "multiAddress": {
        "$call": "supported",
        "args": [
          {
            "ref": {
              "url": "https://support.keyst.one/basic-features/adding-multiple-addresses",
              "explanation": "Keystone's support docs describe adding multiple addresses per asset (up to nine at a time), confirming multi-address derivation."
            }
          }
        ]
      },
      "privacy": {
        "analytics": {
          "crashReports": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://apps.apple.com/us/app/keystone-nexus/id6742313403",
                  "explanation": "The Keystone Nexus App Store privacy label discloses collecting Diagnostics 'Crash Data' for analytics and app functionality."
                }
              }
            ]
          },
          "usage": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://apps.apple.com/us/app/keystone-nexus/id6742313403",
                  "explanation": "The Keystone Nexus companion app's App Store privacy label discloses collecting Diagnostics Performance Data used for 'Analytics' purposes."
                }
              }
            ]
          }
        },
        "dataCollection": null,
        "hardwarePrivacy": null,
        "privacyPolicy": "https://keyst.one/privacy-policy",
        "transactionPrivacy": {
          "STEALTH_ADDRESSES": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://guide.keyst.one/docs/nexusfaq",
                  "explanation": "No Keystone documentation or app materials mention stealth-address receiving support."
                }
              }
            ]
          },
          "PRIVACY_POOLS": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://guide.keyst.one/docs/nexusfaq",
                  "explanation": "No Keystone documentation or app materials mention Privacy Pools integration."
                }
              }
            ]
          },
          "defaultFungibleTokenTransferMode": "PUBLIC"
        }
      },
      "profile": "WalletProfile.GENERIC",
      "security": {
        "accountRecovery": null,
        "bugBountyProgram": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "$ref": "refTodo"
              },
              "availability": "BugBountyProgramAvailability.ACTIVE",
              "coverageBreadth": "FULL_SCOPE",
              "dateStarted": "2021-04-02",
              "disclosure": {
                "$ref": "notSupported"
              },
              "legalProtections": {
                "$call": "supported",
                "args": [
                  {
                    "type": "LegalProtectionType.SAFE_HARBOR",
                    "ref": [
                      {
                        "explanation": "Keystone strongly supports security research into our products and wants to encourage that research.",
                        "url": "https://keyst.one/bug-bounty-program"
                      }
                    ]
                  }
                ]
              },
              "platform": "BugBountyPlatform.SELF_HOSTED",
              "rewards": {
                "$ref": "notSupported"
              },
              "upgradePathAvailable": false
            }
          ]
        },
        "duressResistance": {
          "duressMode": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.keyst.one/advanced-features/passphrase",
                  "explanation": "Keystone supports an optional passphrase 'hidden vault' for plausible deniability, with a default sentinel wallet shown under duress while assets stay in passphrase-protected wallets."
                }
              }
            ]
          }
        },
        "firmware": {
          "type": "FirmwareType.PASS",
          "customFirmware": null,
          "firmwareOpenSource": "FirmwareType.PASS",
          "reproducibleBuilds": "FirmwareType.PASS",
          "silentUpdateProtection": "FirmwareType.PASS"
        },
        "keysHandling": null,
        "lightClient": {
          "ethereumL1": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://shop.keyst.one/products/keystone-3-pro",
                  "explanation": "Keystone is an air-gapped cold signer relying on connected third-party wallets/RPCs and provides no trust-minimized Ethereum L1 light client."
                }
              }
            ]
          }
        },
        "publicSecurityAudits": [
          {
            "ref": [
              {
                "explanation": "Keystone 3 Pro security audit by Keylabs",
                "url": "https://github.com/keylabsio/audits/blob/24e10a7404106494f66c5ebcf49b8fa4eaaa2d3c/2023-11-keystone3.pdf"
              }
            ],
            "auditDate": "2023-11-22",
            "auditor": {
              "$ref": "keylabs"
            },
            "codeSnapshot": null,
            "unpatchedFlaws": "ALL_FIXED",
            "variantsScope": {
              "HARDWARE": true
            }
          },
          {
            "ref": [
              {
                "explanation": "Keystone 3 Pro security audit by SlowMist",
                "url": "https://github.com/slowmist/Knowledge-Base/blob/bbf894fc9c42d1e9af7b2690f54fc94c7d0fc299/open-report-V2/blockchain-application/SlowMist%20Audit%20Report%20-%20Keystone3_en-us.pdf"
              }
            ],
            "auditDate": "2023-09-07",
            "auditor": {
              "$ref": "slowMist"
            },
            "codeSnapshot": null,
            "unpatchedFlaws": "ALL_FIXED",
            "variantsScope": {
              "HARDWARE": true
            }
          }
        ],
        "secureElement": {
          "$call": "supported",
          "args": [
            {
              "ref": [
                {
                  "explanation": "Keystone 3 incorporates a PCI-grade anti-tampering feature, with an intricate ‘security house’ of circuitry encompassing the core IC and SE chips.",
                  "url": "https://blog.keyst.one/secure-elements-the-bedrock-of-hardware-wallet-security-1dd8cbdef461"
                }
              ],
              "secureElementType": "SecureElementType.PCI"
            }
          ]
        },
        "securityBestPractices": null,
        "supplyChainDIY": null,
        "supplyChainFactory": null,
        "transactionLegibility": {
          "ref": [
            {
              "explanation": "Independent video demonstration of Keystone's signing implementation on a Safe.",
              "url": "https://youtu.be/9YmPWxAvKYY?t=759"
            },
            {
              "explanation": "Independent video demonstration of Keystone's transaction implementation on a Safe.",
              "url": "https://youtube.com/shorts/Ly9lo4g5NpA"
            }
          ],
          "dataExtraction": {
            "EYES": true,
            "HASHES": false,
            "QRCODE": true
          },
          "detailsDisplayed": {
            "$spread:displaysFullTransactionDetails": {
              "$ref": "displaysFullTransactionDetails"
            },
            "nonce": "DataDisplayOptions.NOT_IN_UI"
          },
          "erc7730": {
            "$call": "supported",
            "args": [
              {
                "USDC_APPROVAL": "DataLocation.NOT_PROVIDED",
                "AAVE_SUPPLY": "DataLocation.ON_DEVICE",
                "SAFEWALLET_AAVE_SUPPLY_NESTED": "DataLocation.NOT_PROVIDED",
                "SAFEWALLET_AAVE_USDC_APPROVE_SUPPLY_BATCH_NESTED_MULTISEND": "DataLocation.NOT_PROVIDED",
                "AAVE_USDC_APPROVE_SUPPLY_BATCH_NESTED_MULTISEND": "DataLocation.NOT_PROVIDED"
              }
            ]
          },
          "erc8213": null,
          "transactionSimulations": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://blog.keyst.one/blind-signing-a-security-black-hole-for-the-ethereum-community-13f909b848b6",
                  "explanation": "Keystone decodes and displays full transaction/contract details on-device (anti-blind-signing) but there is no evidence of net-balance-change simulation like Blockaid/Blowfish."
                }
              }
            ]
          }
        },
        "userSafety": null,
        "hardwareWalletSupport": {
          "$ref": "notApplicable"
        },
        "passkeyVerification": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://keyst.one/authentication",
                "explanation": "Keystone 3 Pro uses PIN/fingerprint and QR-based device verification; no source indicates passkey/WebAuthn/FIDO2 as a verification factor."
              }
            }
          ]
        },
        "scamAlerts": {
          "contractTransactionWarning": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://keyst.one/",
                  "explanation": "Keystone's documentation focuses on air-gapped clear-signing and secure elements; no blocklist-based malicious-contract warning is described for the device or companion apps."
                }
              }
            ]
          },
          "sendTransactionWarning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://www.bitget.com/amp/academy/keystone-wallet-safe",
                  "explanation": "Keystone firmware includes address-poisoning detection that flags transactions to addresses resembling previous destinations before signing."
                }
              }
            ]
          },
          "scamUrlWarning": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://blog.keyst.one/from-evm-to-solana-how-to-avoid-phishing-scams",
                  "explanation": "Keystone's own blog recommends third-party tools like ScamSniffer for phishing protection rather than a built-in URL blocklist in the device or companion apps."
                }
              }
            ]
          }
        }
      },
      "selfSovereignty": {
        "interoperability": null,
        "permissionsManagement": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://blog.keyst.one/watch-out-for-your-token-approvals-don-t-become-a-hacker-s-atm",
                "explanation": "Keystone displays approve parameters when signing but its Nexus companion has no built-in allowance manager, relying on third-party tools like Revoke.cash to inspect/revoke."
              }
            }
          ]
        },
        "transactionSubmission": {
          "l1": {
            "selfBroadcastViaSelfHostedNode": {
              "$call": "supported",
              "args": [
                {
                  "ref": {
                    "url": "https://support.keyst.one/3rd-party-wallets/bitcoin-wallets",
                    "explanation": "Keystone integrates with Sparrow, Specter (full-node focused), and Electrum — all of which let users connect to their own self-hosted node — plus MetaMask with configurable custom RPC."
                  }
                }
              ]
            }
          }
        }
      },
      "transparency": {
        "maintenance": null,
        "operationFees": null,
        "releaseTransparency": {
          "artifactSigning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://keyst.one/usb-upgrade",
                  "explanation": "Keystone's firmware verification rejects any update not signed with Keystone's private key; only officially signed packages are accepted."
                }
              }
            ]
          },
          "dependencyLocking": null,
          "dependencyVulnerabilityScanning": null,
          "hasPublicChangelog": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.keyst.one/changelog/keystone-companion-app",
                  "explanation": "Keystone publishes a public changelog for its companion app with version release notes."
                }
              }
            ]
          },
          "hermeticBuilds": null,
          "repositoryChangeControls": null,
          "reproducibleBuilds": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://github.com/KeystoneHQ/keystone3-firmware/blob/master/docs/verify.md",
                  "explanation": "Keystone documents reproducible firmware builds via Docker, letting users compile from source and compare SHA256 checksums against released firmware."
                }
              }
            ]
          }
        },
        "reputation": null
      },
      "chainAbstraction": {
        "bridging": {
          "builtInBridging": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://guide.keyst.one/docs/nexusfaq",
                  "explanation": "The Keystone Nexus companion app offers asset swaps but no native cross-chain bridging feature is documented in its FAQ."
                }
              }
            ]
          }
        },
        "crossChainBalances": {
          "globalAccountValue": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://keyst.one/nexus",
                  "explanation": "Keystone Nexus provides multi-chain asset viewing with a unified/aggregated balance across supported chains."
                }
              }
            ]
          }
        }
      },
      "addressResolution": {
        "nonChainSpecificEnsResolution": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://support.keyst.one/advanced-features/displaying-ens-names",
                "explanation": "Keystone supports ENS name resolution/display by loading an offline ENS database, showing the .eth name alongside the on-chain address when signing."
              }
            }
          ]
        }
      }
    },
    "variants": {
      "HARDWARE": true
    }
  }
}