{
  "id": "gridplus",
  "source": "hardware-wallets",
  "export": "gridplusWallet",
  "data": {
    "metadata": {
      "id": "gridplus",
      "displayName": "GridPlus Wallet",
      "tableName": "GridPlus",
      "blurb": "GridPlus Wallet is a secure hardware wallet that combines secure key storage with convenient authentication methods.",
      "contributors": [
        {
          "$ref": "nconsigny"
        },
        {
          "$ref": "patrickalphac"
        },
        {
          "$ref": "mattmatt"
        }
      ],
      "hardwareWalletManufactureType": "HardwareWalletManufactureType.FACTORY_MADE",
      "hardwareWalletModels": [
        {
          "id": "gridplus-lattice1",
          "name": "GridPlus Lattice1",
          "isFlagship": true,
          "url": "https://gridplus.io/products/lattice1"
        }
      ],
      "iconExtension": "svg",
      "lastUpdated": "2025-03-12",
      "urls": {
        "docs": [
          "https://docs.gridplus.io/"
        ],
        "repositories": [
          "https://github.com/GridPlus"
        ],
        "socials": {
          "discord": "https://discord.com/invite/gridplus",
          "linkedin": "https://www.linkedin.com/company/gridplus/",
          "x": "https://x.com/gridplus/"
        },
        "websites": [
          "https://gridplus.io/"
        ]
      }
    },
    "features": {
      "accountSupport": {
        "defaultAccountType": "AccountType.eoa",
        "eip7702": {
          "$ref": "notSupported"
        },
        "eoa": {
          "$call": "supported",
          "args": [
            {
              "ref": [
                {
                  "explanation": "The Lattice1 supports full BIP-32, BIP-39, and BIP-44 key derivation standards, along with custom derivation paths and non-standard formats such as Ledger Live, Ledger Legacy, and Solflare/Ledger derivation paths for Solana.",
                  "url": "https://docs.gridplus.io/lattice1/how-to-manage-your-seed-phrase"
                }
              ],
              "canExportPrivateKey": false,
              "keyDerivation": {
                "type": "BIP32",
                "canExportSeedPhrase": true,
                "derivationPath": "BIP44",
                "seedPhrase": "BIP39"
              }
            }
          ]
        },
        "mpc": {
          "$ref": "notSupported"
        },
        "rawErc4337": {
          "$ref": "notSupported"
        },
        "safe": {
          "$ref": "notSupported"
        }
      },
      "appConnectionSupport": {
        "$call": "supported",
        "args": [
          {
            "ref": "https://docs.gridplus.io/apps-and-integrations/lattice-manager",
            "requiresManufacturerConsent": null,
            "supportedConnections": {
              "VENDOR_OPEN_SOURCE_APP": true,
              "METAMASK": true,
              "RABBY": true,
              "AMBIRE": true,
              "FRAME": true,
              "OTHER": true
            }
          }
        ]
      },
      "licensing": {
        "$ref": "fullyClosedSource",
        "walletAppLicense": {
          "license": "Proprietary (firmware); MIT (SDK/keyring); Lattice Manager unlicensed",
          "ref": {
            "url": "https://github.com/orgs/GridPlus/repositories",
            "explanation": "The Lattice1 firmware is proprietary/closed-source while GridPlus's supporting tools like gridplus-sdk and eth-lattice-keyring are MIT and the lattice-manager repo specifies no license."
          }
        }
      },
      "monetization": {
        "ref": [
          {
            "explanation": "Grid+ is the first internally incubated venture to spin out of ConsenSys.",
            "url": "https://medium.com/@mark_dago/grid-progress-report-12-15-2017-fdb4e24ed2ed"
          },
          {
            "explanation": "GridPlus VC funding includes Bankless Ventures, ConsenSys Mesh, Allatus Ventures, Dlab, and Game7.",
            "url": "https://pitchbook.com/profiles/company/184644-55"
          }
        ],
        "revenueBreakdownIsPublic": false,
        "strategies": {
          "donations": null,
          "ecosystemGrants": null,
          "governanceTokenLowFloat": null,
          "governanceTokenMostlyDistributed": null,
          "hiddenConvenienceFees": null,
          "publicOffering": null,
          "selfFunded": null,
          "transparentConvenienceFees": null,
          "ventureCapital": true
        }
      },
      "multiAddress": null,
      "privacy": {
        "analytics": {
          "crashReports": null,
          "usage": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/lattice1/lattice1-introduction",
                  "explanation": "GridPlus documentation states it does not collect user data on the Lattice Manager and end-to-end encrypts device messages, with no usage telemetry indicated."
                }
              }
            ]
          }
        },
        "dataCollection": null,
        "hardwarePrivacy": {
          "$call": "supported",
          "args": [
            {
              "type": "HardwarePrivacyType.PARTIAL",
              "ref": [
                {
                  "explanation": "GridPlus does not implement telemetry. They do not store, sell, or share user data. At the point of sale they collect customer shipping information for regulatory compliance, then destroy it within six months.",
                  "url": "https://gridplus.io/policies/privacy-policy"
                }
              ],
              "inspectableRemoteCalls": "HardwarePrivacyType.PARTIAL",
              "phoningHome": "HardwarePrivacyType.PASS",
              "wirelessPrivacy": "HardwarePrivacyType.PARTIAL"
            }
          ]
        },
        "privacyPolicy": "https://gridplus.io/policies/privacy-policy",
        "transactionPrivacy": {
          "STEALTH_ADDRESSES": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/apps-and-integrations/lattice-manager",
                  "explanation": "No GridPlus documentation or repo indicates support for stealth-address receiving on the Lattice1 or its companion apps."
                }
              }
            ]
          },
          "PRIVACY_POOLS": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/apps-and-integrations/lattice-manager",
                  "explanation": "No GridPlus documentation or integration lists Privacy Pools support."
                }
              }
            ]
          },
          "defaultFungibleTokenTransferMode": "PUBLIC"
        }
      },
      "profile": "WalletProfile.GENERIC",
      "security": {
        "accountRecovery": {
          "guardianRecovery": {
            "$ref": "notSupported"
          }
        },
        "bugBountyProgram": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "$ref": "refTodo"
              },
              "availability": "BugBountyProgramAvailability.ACTIVE",
              "coverageBreadth": "FULL_SCOPE",
              "dateStarted": "2021-09-23",
              "disclosure": {
                "$ref": "notSupported"
              },
              "legalProtections": {
                "$call": "supported",
                "args": [
                  {
                    "type": "LegalProtectionType.SAFE_HARBOR",
                    "ref": [
                      {
                        "explanation": "GridPlus pledges not to initiate legal action for security research conducted pursuant to all Bug Bounty Program policies, including good faith, accidental violations.",
                        "url": "https://docs.gridplus.io/resources/bug-bounty-and-responsible-disclosure-policy"
                      }
                    ]
                  }
                ]
              },
              "platform": "BugBountyPlatform.SELF_HOSTED",
              "rewards": {
                "$ref": "notSupported"
              },
              "upgradePathAvailable": true
            }
          ]
        },
        "duressResistance": {
          "duressMode": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/lattice1/how-to-manage-your-seed-phrase",
                  "explanation": "The Lattice1 supports an optional BIP39 passphrase (a 25th word) that generates a separate hidden wallet, functioning as a decoy/hidden-wallet mechanism."
                }
              }
            ]
          }
        },
        "firmware": {
          "type": "FirmwareType.FAIL",
          "customFirmware": "FirmwareType.FAIL",
          "details": "The Lattice1 firmware source code is not publicly available.",
          "firmwareOpenSource": "FirmwareType.FAIL",
          "reproducibleBuilds": "FirmwareType.FAIL",
          "silentUpdateProtection": "FirmwareType.PASS"
        },
        "keysHandling": {
          "ref": [
            {
              "explanation": "The Lattice1 generates and stores key material entirely on-device. Full BIP-32, BIP-39, and BIP-44 derivation standards are supported, along with custom derivation paths.",
              "url": "https://docs.gridplus.io/lattice1/how-to-manage-your-seed-phrase"
            }
          ],
          "keyGeneration": "KeyGenerationLocation.FULLY_ON_USER_DEVICE",
          "multipartyKeyReconstruction": "MultiPartyKeyReconstruction.NON_MULTIPARTY"
        },
        "lightClient": {
          "ethereumL1": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/lattice1/security-features",
                  "explanation": "The Lattice1 relies on connected software wallets/RPCs for chain state and provides no trust-minimized Ethereum L1 light client."
                }
              }
            ]
          }
        },
        "publicSecurityAudits": null,
        "secureElement": {
          "$call": "supported",
          "args": [
            {
              "ref": [
                {
                  "explanation": "The Lattice1 meets stringent security industry standards including FIPS, PCI, and EAL 6+ and is the only hardware wallet designed to safeguard against edge case risks such as attackers remotely accessing a users secrets via RF emissions.",
                  "url": "https://www.prnewswire.com/news-releases/gridplus-sets-a-new-standard-for-blockchain-security-with-the-release-of-the-enterprise-grade-lattice1-wireless-hardware-wallet-301186849.html"
                }
              ],
              "secureElementType": "SecureElementType.EAL_6_PLUS"
            }
          ]
        },
        "securityBestPractices": null,
        "supplyChainDIY": null,
        "supplyChainFactory": null,
        "transactionLegibility": {
          "ref": [
            {
              "explanation": "Independent video demonstration of GridPlus's clear signing implementation on Safe.",
              "url": "https://youtu.be/9YmPWxAvKYY?t=2079"
            },
            {
              "explanation": "Independent video demonstration of GridPlus's transaction implementation on Safe.",
              "url": "https://youtube.com/shorts/_s5PjZhgBig"
            }
          ],
          "dataExtraction": {
            "EYES": true,
            "HASHES": false,
            "QRCODE": false
          },
          "detailsDisplayed": {
            "$ref": "displaysFullTransactionDetails"
          },
          "erc7730": {
            "$call": "supported",
            "args": [
              {
                "USDC_APPROVAL": "DataLocation.NOT_PROVIDED",
                "AAVE_SUPPLY": "DataLocation.ON_DEVICE",
                "SAFEWALLET_AAVE_SUPPLY_NESTED": "DataLocation.ON_DEVICE",
                "SAFEWALLET_AAVE_USDC_APPROVE_SUPPLY_BATCH_NESTED_MULTISEND": "DataLocation.NOT_PROVIDED",
                "AAVE_USDC_APPROVE_SUPPLY_BATCH_NESTED_MULTISEND": null
              }
            ]
          },
          "erc8213": null,
          "transactionSimulations": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/lattice1/how-the-lattice1-makes-transactions-readable-with-abi-decoding",
                  "explanation": "The Lattice1 provides ABI-decoded clear signing of raw transaction data but does not simulate/predict net balance changes before signing."
                }
              }
            ]
          }
        },
        "userSafety": null,
        "hardwareWalletSupport": {
          "$ref": "notApplicable"
        },
        "scamAlerts": {
          "contractTransactionWarning": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/lattice1/how-the-lattice1-makes-transactions-readable-with-abi-decoding",
                  "explanation": "The Lattice1 uses ABI decoding to make calldata human-readable but does not flag/blocklist known-malicious contracts; it relies on the user reading the decoded data."
                }
              }
            ]
          }
        },
        "passkeyVerification": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://docs.gridplus.io/lattice1/security-features",
                "explanation": "The Lattice1 uses a device PIN and SafeCard PIN for authentication with no mention of passkeys/WebAuthn/FIDO in its security documentation."
              }
            }
          ]
        }
      },
      "selfSovereignty": {
        "interoperability": null,
        "permissionsManagement": {
          "$call": "notSupported",
          "args": [
            {
              "ref": {
                "url": "https://docs.gridplus.io/apps-and-integrations/lattice-manager",
                "explanation": "The official Lattice Manager only handles device management and simple BTC send/receive, with no token-approval inspection or revocation feature documented."
              }
            }
          ]
        },
        "transactionSubmission": {
          "l1": {
            "selfBroadcastViaSelfHostedNode": {
              "$call": "supported",
              "args": [
                {
                  "ref": {
                    "url": "https://docs.gridplus.io/apps-and-integrations/lattice-manager/connecting-your-lattice-to-your-own-private-endpoint",
                    "explanation": "GridPlus offers lattice-connect-v2, a self-hosted endpoint users run on their own network to sign and route transactions without any GridPlus infrastructure."
                  }
                }
              ]
            }
          }
        }
      },
      "transparency": {
        "maintenance": null,
        "operationFees": null,
        "releaseTransparency": {
          "artifactSigning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/lattice1/lattice1-guides/how-to-upgrade-the-firmware",
                  "explanation": "GridPlus firmware documentation states every release must be signed by multiple geographically separated private keys and verified by a secure bootloader before installation."
                }
              }
            ]
          },
          "dependencyLocking": null,
          "dependencyVulnerabilityScanning": null,
          "hasPublicChangelog": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://github.com/GridPlus/lattice-software-releases",
                  "explanation": "GridPlus publishes a public changelog of firmware/software releases in the lattice-software-releases GitHub repo and firmware release blog posts."
                }
              }
            ]
          },
          "hermeticBuilds": null,
          "repositoryChangeControls": null,
          "reproducibleBuilds": null
        },
        "reputation": null
      },
      "chainAbstraction": {
        "bridging": {
          "builtInBridging": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/apps-and-integrations/lattice-manager",
                  "explanation": "Neither the Lattice1 firmware nor the Lattice Manager provides native cross-chain bridging functionality."
                }
              }
            ]
          }
        },
        "crossChainBalances": {
          "globalAccountValue": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://docs.gridplus.io/apps-and-integrations/lattice-manager",
                  "explanation": "The Lattice Manager offers a simple BTC wallet and device management but no unified cross-chain account value view."
                }
              }
            ]
          }
        }
      }
    },
    "variants": {
      "HARDWARE": true
    }
  }
}