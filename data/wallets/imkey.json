{
  "id": "imkey",
  "source": "hardware-wallets",
  "export": "imkeyWallet",
  "data": {
    "metadata": {
      "id": "imkey",
      "displayName": "imKey",
      "tableName": "imKey",
      "blurb": "Incubated by imToken, imKey is a reliable digital wallet that supports access to 50+ major networks (including Bitcoin, Ethereum, and Tron). Built with an EAL6+ certified secure chip, imKey ensures private keys are generated, stored, and used entirely within the device for maximum protection. Seamlessly integrated with imToken on mobile and compatible with the Rabby browser extension on PC, imKey enables users to manage assets, interact with apps, and perform transactions with enhanced security and flexibility.",
      "contributors": [
        {
          "$ref": "mako"
        }
      ],
      "hardwareWalletManufactureType": "HardwareWalletManufactureType.FACTORY_MADE",
      "hardwareWalletModels": [
        {
          "id": "imkey-pro",
          "name": "imKey Pro",
          "isFlagship": true,
          "url": "https://imkey.im/products/imkey-pro-crypto-hardware-wallet"
        }
      ],
      "iconExtension": "svg",
      "lastUpdated": "2025-10-30",
      "urls": {
        "repositories": [
          "https://github.com/consenlabs/imkey-core"
        ],
        "websites": [
          "https://imkey.im/"
        ]
      }
    },
    "features": {
      "accountSupport": null,
      "appConnectionSupport": null,
      "licensing": {
        "type": "LicensingType.SEPARATE_CORE_CODE_LICENSE_VS_WALLET_CODE_LICENSE",
        "coreLicense": {
          "ref": [
            {
              "explanation": "Core components are open-sourced under Apache-2.0 on GitHub.",
              "url": "https://github.com/consenlabs/imkey-core"
            }
          ],
          "license": "FOSSLicense.APACHE_2_0"
        },
        "walletAppLicense": {
          "HARDWARE": {
            "ref": [
              {
                "explanation": "Some firmware remains proprietary but reproducible builds ensure verifiable integrity.",
                "url": "https://github.com/consenlabs/imkey-core"
              }
            ],
            "license": "SourceNotAvailableLicense.PROPRIETARY"
          }
        }
      },
      "monetization": {
        "ref": [
          {
            "explanation": "imKey Pro is a one-time hardware purchase with no subscription or custodial service fees. Transactions incur only standard on-chain gas fees.",
            "url": "https://imkey.im/products/imkey-pro-crypto-hardware-wallet"
          }
        ],
        "revenueBreakdownIsPublic": false,
        "strategies": {
          "donations": null,
          "ecosystemGrants": false,
          "governanceTokenLowFloat": null,
          "governanceTokenMostlyDistributed": null,
          "hiddenConvenienceFees": null,
          "publicOffering": null,
          "selfFunded": true,
          "transparentConvenienceFees": null,
          "ventureCapital": false
        }
      },
      "multiAddress": {
        "$ref": "featureSupported"
      },
      "privacy": {
        "analytics": {
          "crashReports": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.token.im/hc/en-us/articles/9395540782617-imToken-on-Security",
                  "explanation": "imToken uses Sentry for error/crash reporting per its official security documentation."
                }
              }
            ]
          },
          "usage": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.token.im/hc/en-us/articles/9395540782617-imToken-on-Security",
                  "explanation": "imToken (imKey Pro's primary companion app) uses Firebase for usage statistics/analytics per its security documentation."
                }
              }
            ]
          }
        },
        "dataCollection": null,
        "hardwarePrivacy": {
          "type": "HardwarePrivacyType.PASS",
          "details": "Private keys are generated and stored within the secure element (EAL6+); no export capability.",
          "inspectableRemoteCalls": "HardwarePrivacyType.PASS",
          "phoningHome": "HardwarePrivacyType.PASS",
          "wirelessPrivacy": "HardwarePrivacyType.PASS"
        },
        "privacyPolicy": "https://token.im/tos-en.html",
        "transactionPrivacy": {
          "STEALTH_ADDRESSES": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://imkey.im/products/imkey-pro-crypto-hardware-wallet",
                  "explanation": "No imKey or imToken documentation indicates support for stealth-address receiving; it is not a listed feature."
                }
              }
            ]
          },
          "PRIVACY_POOLS": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://imkey.im/products/imkey-pro-crypto-hardware-wallet",
                  "explanation": "Neither imKey nor its companion imToken app documents any Privacy Pools integration."
                }
              }
            ]
          },
          "defaultFungibleTokenTransferMode": "PUBLIC"
        }
      },
      "profile": "WalletProfile.GENERIC",
      "security": {
        "accountRecovery": null,
        "bugBountyProgram": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://slowmist.io/imtoken/",
                "explanation": "imKey runs a public 'Vulnerability and Threat Intelligence Bounty Program' and imToken runs a bounty program with SlowMist."
              }
            }
          ]
        },
        "duressResistance": {
          "duressMode": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://imkey.im/products/imkey-pro-crypto-hardware-wallet",
                  "explanation": "imKey Pro documentation describes only a standard 6-8 digit PIN (auto-reset after 5 failed attempts) with no passphrase-based hidden wallet or decoy/duress mode."
                }
              }
            ]
          }
        },
        "firmware": {
          "type": "FirmwareType.PASS",
          "customFirmware": null,
          "details": "All firmware updates are distributed via imKey Manager and must pass digital signature checks. Updates require explicit user confirmation and cannot be installed silently.",
          "firmwareOpenSource": "FirmwareType.PARTIAL",
          "reproducibleBuilds": "FirmwareType.PASS",
          "silentUpdateProtection": "FirmwareType.PASS",
          "url": "https://support.imkey.im/hc/en-001/articles/36709320202649"
        },
        "keysHandling": null,
        "lightClient": {
          "ethereumL1": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://support.token.im/hc/en-us/articles/31423984023961-Scam-Warning-Fraudulent-RPC-Node-Adjustments",
                  "explanation": "imToken/imKey rely on RPC nodes for chain state with no indication of a trust-minimized Ethereum L1 light client."
                }
              }
            ]
          }
        },
        "publicSecurityAudits": null,
        "secureElement": null,
        "securityBestPractices": null,
        "supplyChainDIY": null,
        "supplyChainFactory": {
          "type": "SupplyChainFactoryType.PASS",
          "details": "Manufactured with QA and serial verification; tamper-evident packaging and official-channel logistics mitigate supply chain attacks. Verification: https://imkey.im/pages/sn-check, https://learn.imkey.im/hc/en-001/articles/42589035963417",
          "factoryOpsecAudit": "SupplyChainFactoryType.PASS",
          "factoryOpsecDocs": "SupplyChainFactoryType.PASS",
          "genuineCheck": "SupplyChainFactoryType.PASS",
          "hardwareVerification": "SupplyChainFactoryType.PASS",
          "tamperEvidence": "SupplyChainFactoryType.PASS",
          "tamperResistance": "SupplyChainFactoryType.PASS",
          "url": "https://imkey.im/pages/verify"
        },
        "transactionLegibility": {
          "ref": [
            {
              "explanation": "imKey interacts seamlessly with apps through the imToken in-app browser and supports connection via Rabby or WalletConnect.",
              "url": [
                "https://imkey.im/pages/integrated-wallets",
                "https://learn.imkey.im/hc/en-001/articles/35683788822937"
              ]
            }
          ],
          "dataExtraction": {
            "EYES": true,
            "HASHES": false,
            "QRCODE": false
          },
          "detailsDisplayed": {
            "$spread:displaysFullTransactionDetails": {
              "$ref": "displaysFullTransactionDetails"
            },
            "nonce": "DataDisplayOptions.NOT_IN_UI"
          },
          "erc7730": {
            "$ref": "notSupported"
          },
          "erc8213": null
        },
        "userSafety": null,
        "hardwareWalletSupport": {
          "$ref": "notApplicable"
        },
        "scamAlerts": {
          "sendTransactionWarning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.token.im/hc/en-us/articles/23417185602841-Inventory-of-Common-Address-Phishing-Tactics",
                  "explanation": "imToken automatically hides high-risk address-poisoning transactions and shows a security reminder when a user copies an address from transaction history."
                }
              }
            ]
          },
          "contractTransactionWarning": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://support.token.im/hc/en-us/articles/360039457914-Why-is-the-token-tagged-as-Warning",
                  "explanation": "imToken tags risky tokens/contracts as 'Warning' (pops a security alert on transfer) and hides 'Risk/High Risk' tokens to protect users from malicious contracts."
                }
              }
            ]
          }
        }
      },
      "selfSovereignty": {
        "interoperability": {
          "type": "InteroperabilityType.PASS",
          "details": "Compatible with imToken mobile (Bluetooth) and Rabby browser extension (USB). See also: https://learn.imkey.im/hc/en-001/articles/35683788822937",
          "interoperability": "InteroperabilityType.PASS",
          "noSupplierLinkage": "InteroperabilityType.PASS",
          "url": "https://imkey.im/pages/integrated-wallets"
        },
        "transactionSubmission": {
          "l1": {
            "selfBroadcastViaSelfHostedNode": {
              "$call": "supported",
              "args": [
                {
                  "ref": {
                    "url": "https://support.token.im/hc/en-us/articles/900005324266-imToken-supports-custom-network-RPC-Experience-the-layer-2-ecosystem-now-",
                    "explanation": "imToken supports custom network RPC configuration, available for imKey and imKey Pro, allowing broadcast via a self-hosted node endpoint."
                  }
                }
              ]
            }
          }
        }
      },
      "transparency": {
        "maintenance": null,
        "operationFees": {
          "builtInErc20Swap": {
            "$ref": "notSupported"
          },
          "erc20L1Transfer": {
            "$call": "supported",
            "args": [
              {
                "$ref": "comprehensiveFeesShownByDefault"
              }
            ]
          },
          "ethL1Transfer": {
            "$call": "supported",
            "args": [
              {
                "$ref": "comprehensiveFeesShownByDefault"
              }
            ]
          },
          "uniswapUSDCToEtherSwap": {
            "$ref": "notSupported"
          }
        },
        "releaseTransparency": {
          "artifactSigning": null,
          "dependencyLocking": null,
          "dependencyVulnerabilityScanning": null,
          "hasPublicChangelog": {
            "$call": "supported",
            "args": [
              {
                "ref": {
                  "url": "https://apps.apple.com/us/app/imtoken-btc-eth-wallet/id1384798940",
                  "explanation": "The imToken companion app publishes public per-version release notes on the App Store."
                }
              }
            ]
          },
          "hermeticBuilds": null,
          "repositoryChangeControls": null,
          "reproducibleBuilds": {
            "$call": "notSupported",
            "args": [
              {
                "ref": {
                  "url": "https://walletscrutiny.com/hardware/imkeypro/",
                  "explanation": "WalletScrutiny states imKey Pro builds cannot be reproduced because the current-release source code is not publicly available."
                }
              }
            ]
          }
        },
        "reputation": null
      },
      "addressResolution": {
        "nonChainSpecificEnsResolution": {
          "$call": "supported",
          "args": [
            {
              "ref": {
                "url": "https://support.token.im/hc/en-us/articles/360039447354-How-to-register-and-manage-ENS-domains-with-imToken",
                "explanation": "imToken supports ENS registration, management, and forward/reverse .eth resolution per its help center."
              }
            }
          ]
        }
      }
    },
    "variants": {
      "HARDWARE": true
    }
  }
}