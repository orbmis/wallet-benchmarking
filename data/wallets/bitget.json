					"ref": {
						"$ref": "refTodo"
					},
					"ether": {
						"crossChainSumView": {
							"$ref": "notSupported"
						},
						"perChainBalanceViewAcrossMultipleChains": {
							"$ref": "featureSupported"
						}
					},
					"globalAccountValue": {
						"$ref": "featureSupported"
					},
					"perChainAccountValue": {
						"$ref": "notSupported"
					},
