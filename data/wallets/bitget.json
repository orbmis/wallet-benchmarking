				"extensions": [
					"https://chromewebstore.google.com/detail/bitget-wallet-crypto-web3/jiidiaalihmmhddjgbnbgdfflelocpak"
				],
				"socials": {
					"facebook": "https://www.facebook.com/BitgetWallet/",
