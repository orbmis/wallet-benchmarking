									}
								],
								"feesLargerThan1bps": {
									"afterSingleAction": "FeeDisplayLevel.COMPREHENSIVE",
									"byDefault": "FeeDisplayLevel.COMPREHENSIVE",
									"fullySponsored": false
								},
								"risksExplained": "NOT_IN_UI"
							}
