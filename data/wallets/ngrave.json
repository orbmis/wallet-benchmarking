          "id": "ngrave-zero",
          "name": "NGRAVE Zero",
          "isFlagship": true,
          "url": "https://ngrave.io/zero"
        }
      ],
      "iconExtension": "svg",
      "lastUpdated": "2025-01-07",
      "urls": {
        "socials": {
          "discord": "https://discord.com/invite/gapxmWEBNJ",
